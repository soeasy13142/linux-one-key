# ============================================================================
# Fail2Ban jail 配置模板
# 由 linux-one-key 使用
#
# 注意: 此文件为参考模板，实际配置由脚本自动生成。不要直接修改此文件。
# NOTE: This file is a reference template. Actual configuration is
#       auto-generated by the script. Do not edit this file directly.
# ============================================================================

[DEFAULT]
# 封禁时间（秒），默认 1 小时
bantime = 3600

# 检测时间窗口（秒），默认 10 分钟
findtime = 600

# 最大失败次数
maxretry = 5

# 封禁动作（与防火墙集成）
# 注意: banaction 取决于操作系统，由脚本自动设置。
#       - RHEL/CentOS/Rocky/Alma: firewallcmd-ipset
#       - Debian/Ubuntu:          iptables-ipset-proto6
banaction = firewallcmd-ipset

# 忽略本地回环地址（含 IPv4 和 IPv6）
ignoreip = 127.0.0.1/8 ::1

# ============================================================================
# SSH 防护
# ============================================================================

[sshd]
enabled = true
port = {ssh_port}
filter = sshd
logpath = {auth_log_path}
maxretry = 5
bantime = 3600
findtime = 600

# ============================================================================
# 可选扩展防护（取消注释以启用）
# ============================================================================

# Nginx HTTP 认证防护
# [nginx-http-auth]
# enabled = true
# port = http,https
# filter = nginx-http-auth
# logpath = /var/log/nginx/error.log
# maxretry = 5
# bantime = 3600

# Postfix SMTP 认证防护
# [postfix-sasl]
# enabled = true
# port = smtp,ssmtp
# filter = postfix-sasl
# logpath = /var/log/mail.log
# maxretry = 5
# bantime = 3600

# 重复封禁（多次被封的 IP 延长封禁）
# [recidive]
# enabled = true
# filter = recidive
# logpath = /var/log/fail2ban.log
# bantime = 604800
# findtime = 86400
# maxretry = 3
